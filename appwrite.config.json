{
  "projectId": "6ad94e6500307054874b",
  "projectName": "VulnAgent",
  "functions": [
    {
      "$id": "hydra",
      "name": "Hydra",
      "runtime": "python-3.12",
      "execute": ["any"],
      "events": ["databases.vulnagent.tables.vulnerabilities.rows.*.create"],
      "schedule": "",
      "interval": 60,
      "timeout": 900,
      "enabled": true,
      "logging": true,
      "entrypoint": "src/main.py",
      "commands": "pip install -r requirements.txt",
      "path": "backend/functions/hydra",
      "scopes": []
    },
    {
      "$id": "npm_lockfile",
      "name": "npm lockfile",
      "runtime": "node-22",
      "execute": [],
      "events": [],
      "schedule": "",
      "timeout": 300,
      "enabled": true,
      "logging": true,
      "entrypoint": "src/main.js",
      "commands": "",
      "path": "functions-node/npm_lockfile",
      "scopes": []
    }
  ]
}
