# Appwrite (functions + scripts). The API key needs TablesDB, VectorsDB and functions scopes.
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# GitHub App. Keep the PEM on one line with literal \n escapes, or paste it multi-line.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

# LLM (CI repair step)
LLM_API_KEY=
LLM_MODEL=claude-opus-5

# Embeddings (VectorsDB failure memory)
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1536

# Vulnerability source
OSV_BASE_URL=https://api.osv.dev

# ID of the Node helper function that regenerates lockfiles
NPM_LOCKFILE_FUNCTION_ID=

# Dashboard (public values only)
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_API_FUNCTION_ID=
